{
  "realm": "university-realm",
  "displayName": "University Knowledge Assistant",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 7200,
  "roles": {
    "realm": [
      {
        "id": "role-admin-id",
        "name": "admin",
        "description": "University System Administrator with full catalog and system management rights",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-faculty-id",
        "name": "faculty",
        "description": "University Faculty Member with research and curriculum document access",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-student-id",
        "name": "student",
        "description": "Enrolled University Student with general inquiry and catalog access",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": [
    "student"
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.GOOGLE_CLIENT_ID:placeholder-google-client-id}",
        "clientSecret": "${env.GOOGLE_CLIENT_SECRET:placeholder-google-client-secret}",
        "defaultScope": "openid profile email",
        "prompt": "select_account",
        "syncMode": "IMPORT",
        "useUserinfoEndpoint": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "university-assistant-client",
      "name": "University Knowledge Assistant Web Application",
      "description": "Next.js Frontend & FastAPI Backend Client with PKCE enabled",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "http://127.0.0.1:3000/auth/callback",
        "http://localhost:8000/docs/oauth2-redirect",
        "https://oauth.pstmn.io/v1/callback",
        "https://uka.university.edu/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost:8000",
        "https://uka.university.edu"
      ],
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##https://uka.university.edu/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "university-assistant-client-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "university-assistant-client",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "email-verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "verifyEmail": false
}
