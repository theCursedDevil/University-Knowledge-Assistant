# ==============================================================================
# Generative AI-Based University Knowledge Assistant
# Environment Configuration Template (.env.example)
#
# Copy this file to .env and replace placeholder values with actual secrets.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-for-session-signing

# ------------------------------------------------------------------------------
# Backend Server (FastAPI)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=university-realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=university-assistant-client

# ------------------------------------------------------------------------------
# Relational Database: PostgreSQL 16 (Primary + 2 Read Replicas)
# ------------------------------------------------------------------------------
DB_USER=app
DB_PASSWORD=university_secure_password
DB_NAME=university_db

# Primary Database (Writes + Immediate Reads)
DB_HOST_PRIMARY=localhost
DB_PORT_PRIMARY=5432

# Read Replica 1 (Balanced Reads)
DB_HOST_REPLICA_1=localhost
DB_PORT_REPLICA_1=5433

# Read Replica 2 (Balanced Reads)
DB_HOST_REPLICA_2=localhost
DB_PORT_REPLICA_2=5434

# ------------------------------------------------------------------------------
# Vector Database: Qdrant
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=university_documents
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# Object Storage: MinIO (S3-Compatible)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=university-documents
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Cache & Distributed Locking: Redis 7
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Identity Provider: Keycloak (OAuth 2.0 / OIDC)
# ------------------------------------------------------------------------------
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=university-realm
KEYCLOAK_CLIENT_ID=university-assistant-client
KEYCLOAK_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Large Language Model (LLM) API: Groq
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Alternative fallback provider (optional):
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Embedding Model (Sentence Transformers)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
