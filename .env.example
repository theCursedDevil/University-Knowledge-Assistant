# Copy to .env and replace every CHANGE_ME value with a unique random secret.
ENVIRONMENT=development
DEBUG=false
ENABLE_DEV_AUTH=false
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD
POSTGRES_DB=university_assistant
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
READONLY_DB_PASSWORD=CHANGE_ME_READONLY_DB_PASSWORD
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD
REPL_PASSWORD=CHANGE_ME_REPLICATION_PASSWORD
# Laptop-friendly single-primary mode. Set true and use replica hostnames only with --profile replication.
DB_READ_REPLICAS_ENABLED=false
POSTGRES_REPLICA1_HOST=postgres-primary
POSTGRES_REPLICA2_HOST=postgres-primary
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY
MINIO_ROOT_USER=uka_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET_NAME=university-documents
KEYCLOAK_ADMIN=uka_keycloak_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GROQ_API_KEY=
GEMINI_API_KEY=
# CPU/RAM-friendly local RAG defaults
EMBEDDING_BATCH_SIZE=8
EMBEDDING_NUM_THREADS=1
RAG_INGESTION_BATCH_SIZE=8
RAG_MAX_CONCURRENT_INGESTIONS=1
RAG_TOP_K=4
MAX_UPLOAD_SIZE_BYTES=10485760
GRAFANA_ADMIN_USER=uka_grafana_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/university-realm
KEYCLOAK_AUDIENCE=university-assistant-client
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback

# Frontend build-time public endpoints (local Docker defaults)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=university-realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=university-assistant-client
NEXT_PUBLIC_DEV_LOGIN=false
