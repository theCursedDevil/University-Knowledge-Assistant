# ==============================================================================
# Generative AI-Based University Knowledge Assistant
# Environment Configuration Template (.env.example)
#
# Instructions:
# - Copy this file to `.env`: cp .env.example .env
# - Fill in your actual GROQ_API_KEY (or GEMINI_API_KEY).
# - For Docker Compose (`docker compose up --build`), the default host values
#   are automatically wired to the respective service containers in docker-compose.yml.
# - NEVER commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Security Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# Allowed origins for CORS (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://frontend:3000"]

# Rate Limiting (LLM-invoking endpoints)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LLM_RPM=20

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=university-realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=university-assistant-client

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 (Primary + 2 Read Replicas)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=university_assistant
REPL_PASSWORD=uka_replica_stream_password

# Primary Database (Read-Write)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read Replica 1 (Read-Only Hot Standby)
POSTGRES_REPLICA1_HOST=localhost
POSTGRES_REPLICA1_PORT=5433

# Read Replica 2 (Read-Only Hot Standby)
POSTGRES_REPLICA2_HOST=localhost
POSTGRES_REPLICA2_PORT=5434

# Read-Your-Own-Writes Window (seconds)
READ_YOUR_WRITES_WINDOW_SECONDS=5.0

# ------------------------------------------------------------------------------
# 4. Redis 7 (Caching & Distributed Locking)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_DOCUMENTS_LIST_TTL=60
CACHE_ADMIN_STATS_TTL=60
LOCK_DEFAULT_TIMEOUT_SECONDS=5.0
LOCK_DEFAULT_EXPIRE_SECONDS=30.0

# ------------------------------------------------------------------------------
# 5. Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=university_documents
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 6. MinIO Object Storage (S3-Compatible)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=university-documents
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 7. Keycloak Identity Provider (OAuth 2.0 / OIDC)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=university-realm
KEYCLOAK_CLIENT_ID=university-assistant-client
KEYCLOAK_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 8. Large Language Model (LLM) API: Groq / Gemini
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.30
RAG_LLM_TEMPERATURE=0.1

# Optional alternative provider:
# GEMINI_API_KEY=your_gemini_api_key_here
